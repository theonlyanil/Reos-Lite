<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="10dp"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp">
        <ImageView
            android:id="@+id/modeview"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/listmodeheading"
            android:ellipsize="end"
            android:id="@+id/modename"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_toRightOf="@+id/modeview"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/listmodesubheading"
            android:ellipsize="end"
            android:id="@+id/modedescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="21dp"
            android:layout_marginTop="10dp"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_toRightOf="@+id/modeview"
            android:layout_below="@+id/modename"/>
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_toRightOf="@+id/modename"
            android:layout_alignParentRight="true"
            android:rowCount="1"
            android:columnCount="6">
            <ImageView
                android:id="@+id/colorchosen1"
                android:background="@drawable/circle"
                android:visibility="invisible"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="2dp"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/colorchosen2"
                android:background="@drawable/circle"
                android:visibility="invisible"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="2dp"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/colorchosen3"
                android:background="@drawable/circle"
                android:visibility="invisible"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="2dp"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/colorchosen4"
                android:background="@drawable/circle"
                android:visibility="invisible"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="2dp"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/colorchosen5"
                android:background="@drawable/circle"
                android:visibility="invisible"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="2dp"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/colorchosen6"
                android:background="@drawable/circle"
                android:visibility="invisible"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="2dp"
                android:layout_centerInParent="true"/>
        </GridLayout>
        <ImageView
            android:id="@+id/edit"
            android:layout_width="19dp"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:src="@drawable/edit"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="5dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
