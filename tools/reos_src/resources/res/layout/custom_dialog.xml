<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="28sp"
        android:textColor="@color/dialog_header_text"
        android:gravity="center_vertical"
        android:background="@color/dialog_header"
        android:paddingLeft="@dimen/default_view_padding"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:text="@string/text_mode_choose_color"/>
    <View
        android:background="@color/dialog_view_separator"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.cube26.iota.smartlite.util.ColorPicker
            android:id="@+id/dialogcolorpalette"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"/>
        <ImageView
            android:id="@+id/preview_color"
            android:background="@drawable/circle"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_margin="10dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/default_margin_top"
        android:layout_marginBottom="@dimen/default_margin_bottom">
        <TextView
            android:textSize="@dimen/default_dialog_text_size"
            android:textColor="@color/navtabselectedcolor"
            android:id="@+id/cancel_pick_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_mode_dialog_cancel"
            android:layout_marginEnd="@dimen/default_extended_margin"/>
        <TextView
            android:textSize="@dimen/default_dialog_text_size"
            android:textColor="@color/navtabselectedcolor"
            android:id="@+id/confirm_pick_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/default_extended_margin"
            android:text="@string/text_mode_dialog_confirm"/>
    </LinearLayout>
</LinearLayout>
