<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="106dp">
                <ImageView
                    android:id="@+id/recipe_view"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_margin="@dimen/default_view_margin"
                    android:src="@drawable/anyone_dummy"/>
                <ImageView
                    android:id="@+id/recipe_type_view"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_margin="@dimen/default_view_margin"
                    android:src="@drawable/callactivated"/>
                <ImageView
                    android:id="@+id/alert_preview_color"
                    android:background="@drawable/thin_transparent_circle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="@dimen/default_view_margin"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/default_margin_top">
                <EditText
                    android:textSize="20sp"
                    android:textColor="@color/textColorPrimary"
                    android:gravity="center_vertical"
                    android:id="@+id/alertTitle"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_call_alert"
                    android:singleLine="true"
                    android:inputType="textFilter"
                    android:layout_marginEnd="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <TextView
                    android:textSize="20sp"
                    android:textColor="@color/navigationBarColor"
                    android:gravity="center"
                    android:id="@+id/if_holder_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:text="If anyone"/>
                <requestFocus/>
                <Spinner
                    android:entries="@array/holder"
                    android:id="@+id/alertAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@android:style/Widget.Holo.Light.Spinner"/>
            </LinearLayout>
            <Spinner
                android:entries="@array/holder"
                android:id="@+id/alertAttribute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@android:style/Widget.Holo.Light.Spinner"/>
            <TextView
                android:textSize="20sp"
                android:textColor="#000"
                android:gravity="left"
                android:id="@+id/static_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/default_margin_top"
                android:text="@string/text_make_transition"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/default_margin_top">
                <Spinner
                    android:id="@+id/alertTransition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/default_margin"
                    style="@android:style/Widget.Holo.Light.Spinner"/>
                <TextView
                    android:textSize="20sp"
                    android:textColor="#000"
                    android:gravity="center"
                    android:layout_gravity="top"
                    android:id="@+id/static_color_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/text_static_color"/>
                <ImageButton
                    android:layout_gravity="center_vertical"
                    android:id="@+id/alertColor"
                    android:background="@drawable/add"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="@dimen/default_margin"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:layout_weight="1"/>
            <Button
                android:textSize="22dp"
                android:textColor="@color/colorPrimary"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/alertSave"
                android:background="@color/vibgreen"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/prop_save"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
