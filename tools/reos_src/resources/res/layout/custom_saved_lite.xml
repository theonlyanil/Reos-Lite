<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:padding="@dimen/default_view_padding"
    android:layout_width="match_parent"
    android:layout_height="80dp">
    <CheckBox
        android:textSize="16sp"
        android:textColor="@color/navtabselectedcolor"
        android:id="@+id/lite_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="iota"/>
    <TextView
        android:id="@+id/lite_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:text="offline"
        android:layout_below="@+id/lite_check"/>
    <ImageView
        android:textStyle="bold"
        android:gravity="end"
        android:layout_gravity="right"
        android:id="@+id/lite_edit"
        android:background="@drawable/edit_lite"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="20dp"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:textStyle="bold"
        android:gravity="end"
        android:layout_gravity="right"
        android:id="@+id/lite_flash"
        android:background="@drawable/lite_dummy"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="70dp"
        android:scaleType="fitXY"
        android:layout_alignBaseline="@+id/lite_edit"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
