<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/un_sync_mic_layout"
        android:layout_width="wrap_content"
        android:layout_height="57dp"
        android:layout_marginBottom="30dp"
        android:layout_alignParentTop="true">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/navigationBarColor"
            android:id="@+id/microphone_un"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/default_margin"
            android:layout_marginBottom="10dp"
            android:text="Microphone"
            android:layout_centerVertical="true"/>
        <Switch
            android:id="@+id/sync_microphone_un"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/default_margin"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:layout_below="@+id/un_sync_mic_layout">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/uninstall_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/mic_input_view_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/un_sync_mic_layout">
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/mic_chart_un"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_below="@+id/textView1"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/bright_foreground_disabled_material_light"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sync your lite with"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/bright_foreground_disabled_material_light"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:text="your favourite music tracks using"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/default_neon_image"
                android:background="@drawable/neon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginBottom="15dp"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/bright_foreground_disabled_material_light"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:text="Reos Music"/>
            <Button
                android:textColor="@color/colorPrimary"
                android:layout_gravity="center_horizontal"
                android:id="@+id/download"
                android:background="@color/vibgreen"
                android:padding="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:text="Download Now"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/musiccontainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:background="@drawable/music_sync_header"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="10dp"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="57dp">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/navigationBarColor"
                android:id="@+id/musicheader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/default_margin"
                android:layout_marginBottom="10dp"
                android:text="Music Synchronization"
                android:layout_centerVertical="true"/>
            <Switch
                android:id="@+id/syncmusic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/default_margin"
                android:layout_alignBaseline="@+id/musicheader"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="57dp">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/navigationBarColor"
                android:id="@+id/microphone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/default_margin"
                android:layout_marginBottom="10dp"
                android:text="Microphone"
                android:layout_centerVertical="true"/>
            <Switch
                android:id="@+id/syncMicrophone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/default_margin"
                android:layout_alignBaseline="@+id/microphone"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <FrameLayout
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="10dp">
            <com.cube26.iota.smartlite.neonmusic.visualizer.VisualizerView
                android:id="@+id/musicvisualizer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:id="@+id/mic_input_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/micChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/textView1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/play_music_layout"
                android:background="@drawable/gradient"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <Button
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"
                    android:layout_gravity="center"
                    android:id="@+id/currenttrackname"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Music is not playing right now"
                    android:textAllCaps="false"/>
                <Button
                    android:textColor="@color/colorPrimary"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/playnow"
                    android:background="@null"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap here to play"
                    android:textAllCaps="false"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>
