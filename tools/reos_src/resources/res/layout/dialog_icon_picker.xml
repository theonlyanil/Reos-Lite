<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="28sp"
        android:textColor="@color/dialog_header_text"
        android:gravity="center_vertical"
        android:background="@color/dialog_header"
        android:paddingLeft="@dimen/default_view_padding"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:text="@string/text_mode_dialog_icon"/>
    <View
        android:background="@color/dialog_view_separator"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <GridView
        android:gravity="center"
        android:id="@+id/dialog_icon_grid"
        android:padding="@dimen/default_view_padding"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/default_margin_top"
        android:horizontalSpacing="10dp"
        android:verticalSpacing="10dp"
        android:numColumns="6"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/default_margin_top"
        android:layout_marginBottom="@dimen/default_margin_bottom">
        <TextView
            android:textSize="@dimen/default_dialog_text_size"
            android:textColor="@color/navtabselectedcolor"
            android:id="@+id/cancel_pick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_mode_dialog_cancel"
            android:layout_marginEnd="@dimen/default_extended_margin"/>
        <TextView
            android:textSize="@dimen/default_dialog_text_size"
            android:textColor="@color/navtabselectedcolor"
            android:id="@+id/confirm_pick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/default_margin"
            android:text="@string/text_mode_dialog_confirm"/>
    </LinearLayout>
</LinearLayout>
