<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fab="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="@dimen/default_view_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/navtabselectedcolor"
        android:id="@+id/saved_lites"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/saved_lites"/>
    <View
        android:background="@color/colorPrimaryDark"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/saved_lites"/>
</RelativeLayout>
