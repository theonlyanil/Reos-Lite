<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/colorcordinator"
    android:background="@color/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:orientation="vertical"
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <EditText
                android:textSize="@dimen/default_edit_text_text_size"
                android:textColor="@color/textColorPrimary"
                android:id="@+id/modenameedit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/default_margin_top"
                android:hint="@string/hint_mode_name"
                android:maxLines="1"
                android:inputType="textFilter"/>
            <EditText
                android:textSize="@dimen/default_edit_text_text_size"
                android:textColor="@color/textColorPrimary"
                android:id="@+id/modedescedit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/default_margin_top"
                android:hint="@string/hint_mode_description"
                android:maxLines="1"
                android:inputType="textFilter"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/default_margin_top">
                <TextView
                    android:textSize="@dimen/default_dialog_text_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_mode_icon"/>
                <TextView
                    android:id="@+id/pick_icon"
                    android:paddingLeft="20dp"
                    android:layout_width="75dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/default_margin"
                    style="@android:style/Widget.Holo.Light.Spinner"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/default_dialog_text_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/default_margin_top"
                android:text="@string/text_mode_choose_color"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <LinearLayout
                        android:gravity="start"
                        android:id="@+id/grid_avail_colors"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/default_margin_top">
                        <ImageView
                            android:id="@+id/gridcolor1"
                            android:background="@drawable/circle"
                            android:layout_width="30dp"
                            android:layout_height="30dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/gridcolor2"
                            android:background="@drawable/circle"
                            android:layout_width="30dp"
                            android:layout_height="30dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/gridcolor3"
                            android:background="@drawable/circle"
                            android:layout_width="30dp"
                            android:layout_height="30dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/gridcolor4"
                            android:background="@drawable/circle"
                            android:layout_width="30dp"
                            android:layout_height="30dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/gridcolor5"
                            android:background="@drawable/circle"
                            android:layout_width="30dp"
                            android:layout_height="30dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/gridcolor6"
                            android:background="@drawable/circle"
                            android:layout_width="30dp"
                            android:layout_height="30dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="start"
                        android:id="@+id/gridchosencolors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/default_margin_top">
                        <ImageView
                            android:id="@+id/colorchosen1"
                            android:background="@drawable/circle"
                            android:layout_width="30dp"
                            android:layout_height="30dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/colorchosen2"
                            android:background="@drawable/circle"
                            android:layout_width="30dp"
                            android:layout_height="30dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/colorchosen3"
                            android:background="@drawable/circle"
                            android:layout_width="30dp"
                            android:layout_height="30dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/colorchosen4"
                            android:background="@drawable/circle"
                            android:layout_width="30dp"
                            android:layout_height="30dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/colorchosen5"
                            android:background="@drawable/circle"
                            android:layout_width="30dp"
                            android:layout_height="30dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/colorchosen6"
                            android:background="@drawable/circle"
                            android:layout_width="30dp"
                            android:layout_height="30dp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="start"
                        android:id="@+id/strobe_selection_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/default_margin_top">
                        <FrameLayout
                            android:layout_width="30dp"
                            android:layout_height="30dp">
                            <CheckBox
                                android:id="@+id/colorChecked1"
                                android:visibility="invisible"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                            <TextView
                                android:textSize="22sp"
                                android:textColor="@color/textColorPrimary"
                                android:gravity="center"
                                android:id="@+id/colorStrobe1"
                                android:visibility="invisible"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="S"/>
                        </FrameLayout>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <FrameLayout
                            android:layout_width="30dp"
                            android:layout_height="30dp">
                            <CheckBox
                                android:id="@+id/colorChecked2"
                                android:visibility="invisible"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                            <TextView
                                android:textSize="22sp"
                                android:textColor="@color/textColorPrimary"
                                android:gravity="center"
                                android:id="@+id/colorStrobe2"
                                android:visibility="invisible"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="S"/>
                        </FrameLayout>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <FrameLayout
                            android:layout_width="30dp"
                            android:layout_height="30dp">
                            <CheckBox
                                android:id="@+id/colorChecked3"
                                android:visibility="invisible"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                            <TextView
                                android:textSize="22sp"
                                android:textColor="@color/textColorPrimary"
                                android:gravity="center"
                                android:id="@+id/colorStrobe3"
                                android:visibility="invisible"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="S"/>
                        </FrameLayout>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <FrameLayout
                            android:layout_width="30dp"
                            android:layout_height="30dp">
                            <CheckBox
                                android:id="@+id/colorChecked4"
                                android:visibility="invisible"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                            <TextView
                                android:textSize="22sp"
                                android:textColor="@color/textColorPrimary"
                                android:gravity="center"
                                android:id="@+id/colorStrobe4"
                                android:visibility="invisible"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="S"/>
                        </FrameLayout>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <FrameLayout
                            android:layout_width="30dp"
                            android:layout_height="30dp">
                            <CheckBox
                                android:id="@+id/colorChecked5"
                                android:visibility="invisible"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                            <TextView
                                android:textSize="22sp"
                                android:textColor="@color/textColorPrimary"
                                android:gravity="center"
                                android:id="@+id/colorStrobe5"
                                android:visibility="invisible"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="S"/>
                        </FrameLayout>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <FrameLayout
                            android:layout_width="30dp"
                            android:layout_height="30dp">
                            <CheckBox
                                android:id="@+id/colorChecked6"
                                android:visibility="invisible"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                            <TextView
                                android:textSize="22sp"
                                android:textColor="@color/textColorPrimary"
                                android:gravity="center"
                                android:id="@+id/colorStrobe6"
                                android:visibility="invisible"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="S"/>
                        </FrameLayout>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.3">
                    <ImageView
                        android:id="@+id/add"
                        android:background="@drawable/add"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginTop="@dimen/default_margin_top"/>
                    <ImageView
                        android:id="@+id/remove_chosen_color"
                        android:background="@drawable/remove"
                        android:visibility="invisible"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginTop="@dimen/default_margin_top"/>
                    <FrameLayout
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginTop="@dimen/default_margin_top">
                        <TextView
                            android:textColor="@color/navtabselectedcolor"
                            android:layout_gravity="center"
                            android:id="@+id/set_strobe"
                            android:visibility="invisible"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:text="@string/text_mode_set_strobe"/>
                        <TextView
                            android:textColor="@color/textColorPrimary"
                            android:id="@+id/enable_strobe"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:text="@string/text_mode_enable_strobe"/>
                    </FrameLayout>
                    <View
                        android:background="@color/navigationBarColor"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:background="@color/navigationBarColor"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/default_margin_top"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="@dimen/default_dialog_text_size"
                android:textColor="@color/modescreentext"
                android:id="@+id/textView6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/default_margin_top"
                android:text="@string/modetransition"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:weightSum="1">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textSize="@dimen/default_small_text_size"
                    android:textColor="@color/transitionsettings"
                    android:layout_gravity="bottom"
                    android:id="@+id/textView7"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    android:text="@string/modeluminosity"
                    android:layout_weight="0.4"/>
                <com.appyvet.rangebar.RangeBar xmlns:custom="http://schemas.android.com/apk/res-auto"
                    android:id="@+id/intervalbar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.6"
                    custom:tickStart="0"
                    custom:tickEnd="100"
                    custom:tickInterval="20"
                    custom:barColor="@color/transitionsettings"
                    custom:pinColor="@color/navtabselectedcolor"
                    custom:selectorSize="@dimen/default_pin_radius"
                    custom:rangeBar="false"
                    custom:connectingLineColor="@color/navtabselectedcolor"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:weightSum="1">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textSize="@dimen/default_small_text_size"
                    android:textColor="@color/transitionsettings"
                    android:layout_gravity="bottom"
                    android:id="@+id/textView8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    android:text="@string/modespeed"
                    android:layout_weight="0.4"/>
                <com.appyvet.rangebar.RangeBar
                    android:id="@+id/speedbar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.6"
                    custom:tickStart="0"
                    custom:tickEnd="100"
                    custom:tickInterval="20"
                    custom:barColor="@color/transitionsettings"
                    custom:pinColor="@color/navtabselectedcolor"
                    custom:selectorSize="@dimen/default_pin_radius"
                    custom:rangeBar="false"
                    custom:connectingLineColor="@color/navtabselectedcolor"/>
            </LinearLayout>
            <Button
                android:textSize="@dimen/default_button_text_size"
                android:textColor="@color/createmood"
                android:id="@+id/createmode"
                android:background="@color/vibgreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/default_margin_top"
                android:layout_marginBottom="@dimen/default_margin"
                android:text="@string/button_mode_save"/>
        </LinearLayout>
    </ScrollView>
</android.support.design.widget.CoordinatorLayout>
