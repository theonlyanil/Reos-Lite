<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_on_boarding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.v4.view.ViewPager
        android:id="@+id/intro_view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <FrameLayout
        android:id="@+id/lite_view_layout"
        android:layout_width="97dp"
        android:layout_height="175dp"
        android:layout_marginTop="100dp"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/lite_view_top"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/lite_base"
            android:scaleType="fitCenter"/>
        <android.support.v7.widget.AppCompatImageView
            android:layout_gravity="top"
            android:id="@+id/lite_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitStart"
            app:srcCompat="@drawable/ic_lite_cover_top"/>
    </FrameLayout>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/view_pager_indicator_layout"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:layout_marginBottom="20dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/view_pager_indicator_dots"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <TextView
        android:textColor="@color/walkthrough_color"
        android:gravity="center"
        android:id="@+id/skip_view"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginBottom="25dp"
        android:text="@string/onboarding_skip"
        android:layout_alignBaseline="@+id/view_pager_indicator_layout"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/default_extended_margin"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
