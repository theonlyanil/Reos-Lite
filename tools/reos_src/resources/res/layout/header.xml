<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:padding="@dimen/default_view_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/navtabselectedcolor"
        android:id="@+id/new_lite_detected_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/new_lite_detected"/>
    <TextView
        android:id="@+id/rename_to_save_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rename_to_save"
        android:layout_below="@+id/new_lite_detected_text"/>
    <View
        android:background="@color/colorPrimaryDark"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/rename_to_save_text"/>
</RelativeLayout>
