<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textSize="30sp"
        android:textColor="#000"
        android:id="@+id/about_support_help"
        android:paddingBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/about_support_help"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">
        <ImageView
            android:id="@+id/mail_share"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/email"
            android:scaleType="fitXY"/>
    </LinearLayout>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textSize="30sp"
        android:paddingBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/about_support_or"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/navtabselectedcolor"
        android:gravity="center"
        android:id="@+id/about_support_call"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about_support_call"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textSize="30sp"
        android:paddingBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/about_support_or"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/navtabselectedcolor"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/about_support_whatsapp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/about_support_whatsapp"
        android:drawableLeft="@drawable/whatsappactivated"
        android:drawablePadding="5dp"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/navtabselectedcolor"
        android:gravity="center"
        android:id="@+id/about_support_faqs"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about_support_faqs"/>
</LinearLayout>
