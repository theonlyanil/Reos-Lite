<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="@dimen/default_view_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/about_schedule"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/alert"
                    android:gravity="center_vertical"
                    android:id="@+id/schedule_name"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:text="hello"
                    android:layout_weight="1"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/alert"
                    android:gravity="center_vertical"
                    android:id="@+id/schedule_time"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:text="hello"
                    android:layout_weight="1"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/alert"
                    android:gravity="center_vertical"
                    android:id="@+id/schedule_days"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:text="hello"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerInParent="true">
                <ImageView
                    android:id="@+id/schedule_mode_color"
                    android:background="@drawable/thin_transparent_circle"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_margin="@dimen/default_view_margin"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/alert"
                    android:id="@+id/schedule_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="hello"/>
            </LinearLayout>
            <Switch
                android:id="@+id/schedule_valid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:layout_marginRight="@dimen/default_margin"
                android:layout_marginBottom="23dp"
                android:layout_alignBaseline="@+id/about_schedule"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
