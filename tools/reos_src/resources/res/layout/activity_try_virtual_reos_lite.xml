<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="22sp"
        android:textColor="@color/navtabselectedcolor"
        android:id="@+id/virtual_reos_lite_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="@string/virtual_reos_lite_bulb"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/virtual_reos_lite_laptop_ipad_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_below="@+id/virtual_reos_lite_text"
        android:layout_centerHorizontal="true"
        app:srcCompat="@drawable/virtual_reos_lite_laptop_ipad"/>
    <TextView
        android:id="@+id/virtual_reos_lite_uri_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/virtual_reos_lite_uri"
        android:layout_below="@+id/virtual_reos_lite_laptop_ipad_image"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:gravity="center"
        android:id="@+id/virtual_reos_lite_usage_desc_text"
        android:paddingLeft="25dp"
        android:paddingRight="25dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/virtual_reos_lite_usage_desc"
        android:layout_below="@+id/virtual_reos_lite_uri_text"
        android:layout_alignParentStart="true"/>
    <Button
        android:textColor="@color/highlighted_text_color"
        android:id="@+id/virtual_reos_lite_scan_qr_code_button"
        android:background="@color/navtabselectedcolor"
        android:padding="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="@string/virtual_reos_lite_scan_qr_code"
        android:layout_below="@+id/virtual_reos_lite_usage_desc_text"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
