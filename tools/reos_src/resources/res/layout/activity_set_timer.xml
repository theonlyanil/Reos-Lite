<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/default_view_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/state_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/default_edit_text_text_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/default_margin"
            android:text="@string/turn_the_bulb"/>
        <Switch
            android:id="@+id/lite_turn_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOn="ON"
            android:textOff="OFF"
            android:thumb="@drawable/switch_slider"
            android:switchTextAppearance="@style/custom_switch"
            android:track="@drawable/switch_track"
            android:thumbTextPadding="5dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/time_indicators"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/default_margin"
        android:layout_below="@+id/state_layout"
        android:layout_centerHorizontal="true">
        <View
            android:background="@color/colorPrimaryDark"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="22sp"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:id="@+id/time_picker"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="00 : 00"/>
        <View
            android:background="@color/colorPrimaryDark"
            android:layout_width="100dp"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="22sp"
            android:gravity="center"
            android:id="@+id/time_picker_descriptor"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="h : m"/>
    </LinearLayout>
    <com.cube26.iota.smartlite.util.ArcProgress
        android:id="@+id/timerProgress"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_centerInParent="true"
        custom:arc_progress="0"
        custom:arc_text_size="30sp"
        custom:arc_text_color="@color/colorPrimaryDark"/>
    <ToggleButton
        android:textSize="22dp"
        android:textColor="@color/colorPrimary"
        android:id="@+id/setTimer"
        android:background="@color/vibgreen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textOn="@string/reset"
        android:textOff="@string/set"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
