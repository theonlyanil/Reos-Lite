<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lyt_container"
    android:padding="@dimen/default_view_padding"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/default_margin">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/highlighted_text_color"
            android:ellipsize="start"
            android:id="@+id/alert_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/default_text_color"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/alert_effect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/alert_recipe_view"
            android:background="@drawable/transparent_circle"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginRight="@dimen/default_view_margin"
            android:src="@drawable/anyone_dummy"/>
        <ImageView
            android:id="@+id/alert_recipe_type_view"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginRight="@dimen/default_view_margin"
            android:src="@drawable/callactivated"/>
        <ImageView
            android:id="@+id/alert_preview_color"
            android:background="@drawable/transparent_circle"
            android:layout_width="30dp"
            android:layout_height="30dp"/>
    </LinearLayout>
    <Switch
        android:gravity="right"
        android:id="@+id/alert_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
