<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/lite_configure_dialog_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="28sp"
        android:textColor="@color/dialog_header_text"
        android:gravity="center_vertical"
        android:background="@color/dialog_header"
        android:paddingLeft="@dimen/default_view_padding"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:text="@string/configure_lites"/>
    <View
        android:background="@color/dialog_view_separator"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/lite_configuration_layout"
        android:padding="@dimen/default_view_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/default_dialog_text_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rename_lites"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/default_margin_top"
        android:layout_marginBottom="@dimen/default_margin_bottom">
        <TextView
            android:textSize="@dimen/default_dialog_text_size"
            android:textColor="@color/navtabselectedcolor"
            android:id="@+id/cancel_config"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/default_margin"
            android:text="@string/cancel"/>
        <TextView
            android:textSize="@dimen/default_dialog_text_size"
            android:textColor="@color/navtabselectedcolor"
            android:id="@+id/confirm_config"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/default_margin"
            android:text="@string/set"/>
    </LinearLayout>
</LinearLayout>
