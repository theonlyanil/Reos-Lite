<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/walkthrough_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/walkthrough_place_holder"
        android:layout_width="wrap_content"
        android:layout_height="150dp"
        android:layout_marginTop="220dp"
        android:src="@drawable/walkthrough_music"
        android:layout_marginStart="@dimen/default_extended_margin"
        android:layout_marginEnd="@dimen/default_extended_margin"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linearLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="400dp"
        android:layout_marginStart="@dimen/default_extended_margin">
        <TextView
            android:textSize="22sp"
            android:textColor="@color/walkthrough_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/frag_2_title"/>
        <TextView
            android:textColor="@color/walkthrough_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/default_margin"
            android:text="@string/frag_2_desc"/>
    </LinearLayout>
</RelativeLayout>
