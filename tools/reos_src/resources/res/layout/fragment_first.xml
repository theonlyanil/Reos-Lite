<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/walkthrough_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="400dp"
        android:layout_marginStart="@dimen/default_extended_margin">
        <TextView
            android:textSize="22sp"
            android:textColor="@color/walkthrough_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/frag_1_title"/>
        <TextView
            android:textColor="@color/walkthrough_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/default_margin"
            android:text="@string/frag_1_desc"/>
    </LinearLayout>
</RelativeLayout>
