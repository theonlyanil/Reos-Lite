<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <Button
        android:id="@+id/off"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"/>
    <ToggleButton
        android:id="@+id/on"
        android:background="@drawable/on"
        android:padding="2dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="37dp"
        android:textOn=""
        android:textOff=""
        android:layout_alignBaseline="@+id/off"
        android:layout_marginEnd="@dimen/default_margin"
        android:layout_alignParentEnd="true"/>
    <Button
        android:id="@+id/imagePicker"
        android:background="@drawable/camera"
        android:padding="2dp"
        android:layout_width="35dp"
        android:layout_height="30dp"
        android:layout_marginTop="37dp"
        android:textOn=""
        android:textOff=""
        android:layout_alignBaseline="@+id/off"
        android:layout_marginStart="@dimen/default_margin"
        android:layout_marginEnd="@dimen/default_margin"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/imageContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/default_margin"
        android:layout_marginTop="45dp"
        android:layout_marginRight="@dimen/default_margin"
        android:weightSum="0.92"
        android:layout_below="@+id/off">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.8">
            <com.cube26.iota.smartlite.util.ColorPicker
                android:layout_gravity="center"
                android:id="@+id/colorpalette"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/imagePalette"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/temp_palette"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>
        </FrameLayout>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/color_source_picker_view"
            android:background="#00000000"
            android:layout_width="30dp"
            android:layout_height="30dp"/>
        <com.appyvet.rangebar.RangeBar
            android:id="@+id/bright"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.12"
            custom:tickStart="1"
            custom:tickEnd="100"
            custom:tickInterval="1"
            custom:tickHeight="4dp"
            custom:tickColor="@color/transparent"
            custom:barWeight="1dp"
            custom:barColor="@color/textColorPrimary"
            custom:selectorSize="3dp"
            custom:pinPadding="2dp"
            custom:selectorColor="@color/navtabselectedcolor"
            custom:rangeBar="false"
            custom:connectingLineWeight="3dp"
            custom:pinRadius="4dp"/>
    </LinearLayout>
</RelativeLayout>
