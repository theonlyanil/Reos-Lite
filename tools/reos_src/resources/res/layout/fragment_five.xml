<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scheduleFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/header"
            android:background="@drawable/scheduler_header"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="10dp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/header">
            <ListView
                android:id="@+id/scheduleList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:gravity="center"
                android:id="@+id/emptyView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/no_schedule_text"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </RelativeLayout>
    <com.github.clans.fab.FloatingActionMenu
        android:id="@+id/menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="76dp"
        app:layout_anchor="@+id/header"
        app:layout_anchorGravity="end|bottom"
        app:menu_fab_size="normal"
        app:menu_colorNormal="@color/navtabselectedcolor"
        app:menu_colorPressed="@color/navtabselectedcolor"
        app:menu_colorRipple="@color/navtabselectedcolor"
        app:menu_openDirection="down"
        app:menu_backgroundColor="@android:color/transparent">
        <com.github.clans.fab.FloatingActionButton
            android:id="@+id/add_timer"
            android:background="@color/timer_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/timer"
            app:fab_colorNormal="@color/timer_back"
            app:fab_colorPressed="@color/timer_back"
            app:fab_colorDisabled="@color/timer_back"
            app:fab_size="mini"
            app:fab_label="@string/add_timer"/>
        <com.github.clans.fab.FloatingActionButton
            android:id="@+id/add_scheduler"
            android:background="@color/timer_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/calendar"
            app:fab_colorNormal="@color/timer_back"
            app:fab_colorPressed="@color/timer_back"
            app:fab_colorDisabled="@color/timer_back"
            app:fab_size="mini"
            app:fab_label="@string/add_scheduler"/>
    </com.github.clans.fab.FloatingActionMenu>
</android.support.design.widget.CoordinatorLayout>
