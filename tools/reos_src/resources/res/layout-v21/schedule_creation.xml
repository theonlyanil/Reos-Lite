<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/default_margin">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <EditText
            android:textSize="20sp"
            android:textColor="@color/textColorPrimary"
            android:gravity="center_vertical"
            android:id="@+id/scheduleName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/default_margin_top"
            android:hint="@string/schedule_name_hint"
            android:singleLine="true"
            android:inputType="textFilter"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/default_extended_margin">
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="@color/modescreentext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/schedule_lite_state"/>
            <Switch
                android:id="@+id/scheduleLiteState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/default_margin"
                android:layout_marginRight="@dimen/default_margin"
                android:textOn="ON"
                android:textOff="OFF"
                android:thumb="@drawable/switch_slider"
                android:switchTextAppearance="@style/custom_switch"
                android:track="@drawable/switch_track"
                android:thumbTextPadding="5dp"
                android:showText="true"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="@color/modescreentext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/default_margin"
                android:text="@string/scheduleStart"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="@color/modescreentext"
                    android:id="@+id/scheduleTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/schedule_default_start_time"/>
                <View
                    android:background="@color/colorPrimaryDark"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/scheduleColorPickerLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/default_extended_margin">
            <TextView
                android:textSize="20sp"
                android:textColor="@color/modescreentext"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/text_static_color"/>
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/scheduleColorPicker"
                android:background="@drawable/add"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="@dimen/default_margin"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/schedulePreviewColor"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="@dimen/default_margin"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/default_extended_margin">
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="@color/modescreentext"
                android:id="@+id/repeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scheduleRepeat"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/default_margin_top">
            <ToggleButton
                android:textSize="10sp"
                android:textColor="@drawable/toggle_text"
                android:id="@+id/scheduleMon"
                android:background="@drawable/toggle_selector"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:textOn="M"
                android:textOff="M"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ToggleButton
                android:textSize="10sp"
                android:textColor="@drawable/toggle_text"
                android:id="@+id/scheduleTue"
                android:background="@drawable/toggle_selector"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:textOn="T"
                android:textOff="T"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ToggleButton
                android:textSize="10sp"
                android:textColor="@drawable/toggle_text"
                android:id="@+id/scheduleWed"
                android:background="@drawable/toggle_selector"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:textOn="W"
                android:textOff="W"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ToggleButton
                android:textSize="10sp"
                android:textColor="@drawable/toggle_text"
                android:id="@+id/scheduleThu"
                android:background="@drawable/toggle_selector"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:textOn="Th"
                android:textOff="Th"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ToggleButton
                android:textSize="10sp"
                android:textColor="@drawable/toggle_text"
                android:id="@+id/scheduleFri"
                android:background="@drawable/toggle_selector"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:textOn="F"
                android:textOff="F"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ToggleButton
                android:textSize="10sp"
                android:textColor="@drawable/toggle_text"
                android:id="@+id/scheduleSat"
                android:background="@drawable/toggle_selector"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:textOn="S"
                android:textOff="S"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ToggleButton
                android:textSize="10sp"
                android:textColor="@drawable/toggle_text"
                android:id="@+id/scheduleSun"
                android:background="@drawable/toggle_selector"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:textOn="Su"
                android:textOff="Su"/>
        </LinearLayout>
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/default_margin_top">
                <CheckBox
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="@color/modescreentext"
                    android:id="@+id/scheduleEverydayCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scheduleEveryday"/>
                <Spinner
                    android:id="@+id/scheduleAlertSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/default_margin"
                    android:layout_marginRight="@dimen/default_margin"
                    style="@android:style/Widget.Holo.Light.Spinner"/>
                <EditText
                    android:id="@+id/scheduleAlertSettingsInterval"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/default_margin"
                    android:text="@string/schedule_default_alert_mins"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:selectAllOnFocus="true"
                    android:inputType="numberDecimal"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:id="@+id/scheduleAlertSettingsIntervalText"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/schedule_alert_mins"/>
            </LinearLayout>
        </HorizontalScrollView>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <Button
            android:textSize="22sp"
            android:textColor="@color/colorPrimary"
            android:layout_gravity="center"
            android:id="@+id/scheduleSave"
            android:background="@color/vibgreen"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/default_margin_top"
            android:text="@string/scheduleSave"/>
    </LinearLayout>
</LinearLayout>
