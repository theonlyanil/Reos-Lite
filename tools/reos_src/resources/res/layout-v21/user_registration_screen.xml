<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/unreg_screen_bg_layout"
            android:background="@drawable/unreg_screen_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_registration_options"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:layout_marginTop="180dp"
                android:layout_marginRight="25dp"
                android:layout_marginBottom="35dp"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_below="@+id/layout_registration_options"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:gravity="center"
                android:id="@+id/register_try_virtual_lite_text"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:text="@string/try_virtual_reos_lite"
                android:layout_alignParentBottom="true"/>
            <FrameLayout
                android:background="@color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true">
                <TextView
                    android:textSize="25dp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/do_more_with_lite"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/do_more_with_lite"/>
                <FrameLayout
                    android:id="@+id/register_layout"
                    android:background="@color/transparent"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="16dp">
                    <RelativeLayout
                        android:id="@+id/register_dialog"
                        android:background="@color/transparent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:id="@+id/container"
                            android:background="@drawable/email_user_registration_dialog_shape"
                            android:paddingLeft="16dp"
                            android:paddingTop="8dp"
                            android:paddingRight="16dp"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentStart="true"
                            android:elevation="0dp">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="5dp">
                                <android.support.v7.widget.AppCompatImageView
                                    android:id="@+id/register_help"
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:layout_margin="5dp"
                                    android:layout_centerVertical="true"
                                    android:layout_alignParentEnd="true"
                                    app:srcCompat="@drawable/help_drawble"/>
                                <TextView
                                    android:textSize="16sp"
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:id="@+id/textView"
                                    android:padding="10dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/register_with_email"
                                    android:layout_alignParentTop="true"
                                    android:layout_alignParentStart="true"/>
                            </RelativeLayout>
                            <LinearLayout
                                android:gravity="center"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="10dp">
                                <Button
                                    android:textSize="14sp"
                                    android:textColor="@color/google_color_code"
                                    android:gravity="center"
                                    android:id="@+id/register_google_button"
                                    android:background="@drawable/google_sign_in_shape"
                                    android:padding="8dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="35dp"
                                    android:text="Google"
                                    android:textAllCaps="false"/>
                                <View
                                    android:layout_width="50dp"
                                    android:layout_height="0dp"/>
                                <FrameLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="35dp">
                                    <Button
                                        android:textSize="14sp"
                                        android:textColor="@color/fb_color_code"
                                        android:gravity="center"
                                        android:id="@+id/register_fb_button_overlay"
                                        android:background="@drawable/facebook_sign_in_shape"
                                        android:padding="8dp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="35dp"
                                        android:text="Facebook"
                                        android:drawablePadding="10dp"
                                        android:textAllCaps="false"/>
                                    <com.facebook.login.widget.LoginButton
                                        android:textSize="15sp"
                                        android:textColor="@color/fb_color_code"
                                        android:gravity="center"
                                        android:id="@+id/register_facebook_button"
                                        android:background="@drawable/facebook_sign_in_shape"
                                        android:padding="5dp"
                                        android:visibility="invisible"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAllCaps="false"
                                        app:com_facebook_login_text="Facebook"/>
                                </FrameLayout>
                            </LinearLayout>
                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp">
                                <View
                                    android:layout_gravity="center"
                                    android:background="#ececec"
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="@color/navtabselectedcolor"
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:background="@drawable/or_circle_shape"
                                    android:paddingBottom="3dp"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:text="or"/>
                            </FrameLayout>
                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <LinearLayout
                                    android:orientation="vertical"
                                    android:id="@+id/form_details"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">
                                    <LinearLayout
                                        android:gravity="start"
                                        android:orientation="horizontal"
                                        android:padding="5dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content">
                                        <android.support.v7.widget.AppCompatImageView
                                            android:layout_gravity="center_vertical"
                                            android:id="@+id/imageView"
                                            android:layout_width="30dp"
                                            android:layout_height="30dp"
                                            android:layout_marginRight="5dp"
                                            app:srcCompat="@drawable/register_name_vector"/>
                                        <EditText
                                            android:textSize="16sp"
                                            android:textColorHint="@color/user_reg_screen_hint_color"
                                            android:id="@+id/edit_name"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:hint="Name"
                                            android:maxLines="1"
                                            android:singleLine="true"
                                            android:layout_weight="1"
                                            android:inputType="text"/>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:gravity="center"
                                        android:orientation="horizontal"
                                        android:padding="5dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content">
                                        <RadioGroup
                                            android:gravity="start"
                                            android:orientation="horizontal"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="40dp">
                                            <RadioButton
                                                android:textSize="16sp"
                                                android:id="@+id/radio_male"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginRight="30dp"
                                                android:checked="true"
                                                android:text="   Male"
                                                style="@style/MaleGenderRadioStyle"/>
                                            <RadioButton
                                                android:textSize="16sp"
                                                android:id="@+id/radio_female"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="   Female"
                                                style="@style/FemaleGenderRadioStyle"/>
                                        </RadioGroup>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:gravity="start"
                                        android:orientation="horizontal"
                                        android:padding="5dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content">
                                        <android.support.v7.widget.AppCompatImageView
                                            android:layout_gravity="center_vertical"
                                            android:id="@+id/appCompatImageView3"
                                            android:layout_width="30dp"
                                            android:layout_height="30dp"
                                            android:layout_marginRight="5dp"
                                            app:srcCompat="@drawable/mobile_number_vector"/>
                                        <EditText
                                            android:textSize="16sp"
                                            android:textColorHint="@color/user_reg_screen_hint_color"
                                            android:id="@+id/edit_mobile_no"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:hint="Mobile No."
                                            android:maxLines="1"
                                            android:singleLine="true"
                                            android:layout_weight="1"
                                            android:inputType="numberDecimal"/>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:gravity="start"
                                        android:orientation="horizontal"
                                        android:padding="5dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content">
                                        <android.support.v7.widget.AppCompatImageView
                                            android:layout_gravity="center_vertical"
                                            android:id="@+id/imageView2"
                                            android:layout_width="30dp"
                                            android:layout_height="30dp"
                                            android:layout_marginRight="5dp"
                                            app:srcCompat="@drawable/email_id_vector"/>
                                        <EditText
                                            android:textSize="16sp"
                                            android:textColorHint="@color/user_reg_screen_hint_color"
                                            android:id="@+id/edit_email_id"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:hint="Email ID"
                                            android:maxLines="1"
                                            android:singleLine="true"
                                            android:layout_weight="1"
                                            android:inputType="textEmailAddress"/>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:gravity="start"
                                        android:orientation="horizontal"
                                        android:padding="5dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content">
                                        <android.support.v7.widget.AppCompatImageView
                                            android:layout_gravity="center_vertical"
                                            android:id="@+id/appCompatImageView"
                                            android:layout_width="30dp"
                                            android:layout_height="30dp"
                                            android:layout_marginRight="5dp"
                                            app:srcCompat="@drawable/date_of_birth_vector"/>
                                        <TextView
                                            android:textSize="16sp"
                                            android:textColorHint="@color/user_reg_screen_hint_color"
                                            android:id="@+id/edit_date_of_birth"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:hint="Date of birth (optional)"
                                            android:maxLines="1"
                                            android:singleLine="true"
                                            android:layout_weight="1"/>
                                    </LinearLayout>
                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="30dp"/>
                                </LinearLayout>
                                <RelativeLayout
                                    android:layout_gravity="center"
                                    android:id="@+id/otp_verify_form"
                                    android:visibility="invisible"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <TextView
                                        android:textSize="18sp"
                                        android:id="@+id/enter_otp_view"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:text="@string/otp_verify_header"
                                        android:layout_centerHorizontal="true"/>
                                    <TextView
                                        android:textSize="14sp"
                                        android:id="@+id/otp_verification_mobile_view"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:layout_below="@+id/enter_otp_view"
                                        android:layout_centerHorizontal="true"/>
                                    <EditText
                                        android:textColorHint="@color/default_color"
                                        android:id="@+id/enter_otp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="150dp"
                                        android:hint="Enter OTP"
                                        android:maxLines="1"
                                        android:minEms="6"
                                        android:singleLine="true"
                                        android:maxLength="6"
                                        android:layout_centerInParent="true"
                                        android:inputType="numberDecimal"
                                        android:textAlignment="center"/>
                                </RelativeLayout>
                            </FrameLayout>
                        </LinearLayout>
                    </RelativeLayout>
                </FrameLayout>
            </FrameLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/reg_screen_bg_layout"
            android:background="@drawable/unreg_screen_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <android.support.v7.widget.AppCompatImageView
                android:id="@+id/splash_app_text"
                android:layout_width="50dp"
                android:layout_height="30dp"
                android:layout_centerInParent="true"
                app:srcCompat="@drawable/splash_lite_text"/>
            <android.support.v7.widget.AppCompatImageView
                android:id="@+id/splash_app_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_toRightOf="@+id/splash_app_text"
                android:layout_above="@+id/splash_app_text"
                app:srcCompat="@drawable/splash_screen_lite_icon"/>
            <android.support.v7.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginBottom="26dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                app:srcCompat="@drawable/img_reos_logo_with_text"/>
        </RelativeLayout>
    </FrameLayout>
    <android.support.design.widget.FloatingActionButton
        android:id="@+id/request_otp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Request OTP"
        app:layout_anchor="@+id/register_layout"
        app:layout_anchorGravity="bottom|center_horizontal"
        app:fab_size="normal"/>
</android.support.design.widget.CoordinatorLayout>
